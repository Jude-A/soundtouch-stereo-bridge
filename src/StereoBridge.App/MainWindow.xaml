<Window x:Class="StereoBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundTouch Stereo Bridge"
        Icon="Assets/app-icon.ico"
        Width="700"
        Height="960"
        MinWidth="640"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#10151C"
        Foreground="#EDF3F7">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="SoundTouch Stereo Bridge" />
                <TextBlock Margin="0,6,0,0" Foreground="#91A3B5"
                           Text="Deux enceintes indépendantes · une paire stéréo synchronisée" />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,24,0,18" Padding="14" CornerRadius="8" Background="#19222D">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="#91A3B5" FontSize="11" FontWeight="Bold" Text="SOURCE AUDIO WINDOWS" />
                        <TextBlock x:Name="SourceText" Margin="0,5,0,0" FontSize="14" Text="Détection…" />
                    </StackPanel>
                    <Button x:Name="RefreshButton" Grid.Column="1" Margin="16,0,0,0"
                            Width="96" Height="34" Click="RefreshButton_Click" Content="Actualiser" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0" Orientation="Horizontal">
                        <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" Foreground="#91A3B5" FontWeight="Bold" Text="MODE" />
                        <RadioButton x:Name="StereoModeButton" Margin="0,0,20,0" VerticalAlignment="Center"
                                     Foreground="#EDF3F7" GroupName="PlaybackMode" Tag="Stereo"
                                     Checked="ModeRadioButton_Checked" Content="Stéréo · G / D" />
                        <RadioButton x:Name="MonoModeButton" VerticalAlignment="Center" Foreground="#EDF3F7"
                                     GroupName="PlaybackMode" Tag="Mono" Checked="ModeRadioButton_Checked"
                                     Content="Mono · même mix sur les deux" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,0,0,18" Padding="14" CornerRadius="8" Background="#19222D">
                <StackPanel>
                    <TextBlock Foreground="#AAB8C5" FontWeight="SemiBold" Text="NIVEAU DE LA PAIRE" />
                    <TextBlock Margin="0,3,0,10" Foreground="#91A3B5" FontSize="11"
                               Text="Le volume suit Windows. Le boost agit sur les deux enceintes et la répartition compense leur distance." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Foreground="#91A3B5" Text="Volume Windows" />
                        <Slider x:Name="WindowsVolumeSlider" Grid.Column="1" Margin="12,0"
                                Minimum="0" Maximum="100" TickFrequency="1"
                                SmallChange="1" LargeChange="5"
                                ValueChanged="WindowsVolumeSlider_ValueChanged" />
                        <TextBlock x:Name="WindowsVolumeText" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" Text="—" />

                        <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Foreground="#91A3B5" Text="Boost commun" />
                        <Slider x:Name="MasterBoostSlider" Grid.Row="1" Grid.Column="1" Margin="12,8"
                                Minimum="0" Maximum="9.5" TickFrequency="0.25"
                                SmallChange="0.25" LargeChange="1" IsSnapToTickEnabled="True"
                                ValueChanged="LevelSlider_ValueChanged" />
                        <TextBlock x:Name="MasterBoostText" Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" VerticalAlignment="Center" TextAlignment="Right" />

                        <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Foreground="#91A3B5" Text="Répartition G / D" />
                        <Slider x:Name="BalanceSlider" Grid.Row="2" Grid.Column="1" Margin="12,8"
                                Minimum="-12" Maximum="12" TickFrequency="0.25"
                                SmallChange="0.25" LargeChange="1" IsSnapToTickEnabled="True"
                                ValueChanged="LevelSlider_ValueChanged" />
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="8,4,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="BalanceText" Width="68" VerticalAlignment="Center" TextAlignment="Right" />
                            <Button Width="38" Height="28" Margin="6,0,0,0" Padding="4,1"
                                    Click="ResetBalanceButton_Click" Content="0" ToolTip="Recentrer la balance" />
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock x:Name="LeftDigitalLevelText" Foreground="#91A3B5" />
                        <TextBlock x:Name="LimiterText" DockPanel.Dock="Right" Foreground="#91A3B5" TextAlignment="Right" />
                        <TextBlock x:Name="RightDigitalLevelText" Margin="24,0,0,0" Foreground="#91A3B5" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <StackPanel x:Name="LeftOutputPanel" Grid.Row="3" Margin="0,0,0,16">
                <TextBlock Margin="0,0,0,7" Foreground="#AAB8C5" FontWeight="SemiBold" Text="ENCEINTE GAUCHE" />
                <ComboBox x:Name="LeftDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LeftDelayText" VerticalAlignment="Center" Foreground="#91A3B5" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Height="30" Margin="0,0,6,0" Padding="10,2" Tag="Left:-1" Click="DelayButton_Click" Content="−1 ms" />
                        <Button Height="30" Margin="0,0,6,0" Padding="10,2" Tag="Left:-0.1" Click="DelayButton_Click" Content="−0,1" />
                        <Button Height="30" Margin="0,0,6,0" Padding="10,2" Tag="Left:0.1" Click="DelayButton_Click" Content="+0,1" />
                        <Button Height="30" Padding="10,2" Tag="Left:1" Click="DelayButton_Click" Content="+1 ms" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="RightOutputPanel" Grid.Row="4" Margin="0,0,0,18">
                <TextBlock Margin="0,0,0,7" Foreground="#AAB8C5" FontWeight="SemiBold" Text="ENCEINTE DROITE" />
                <ComboBox x:Name="RightDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                          />
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RightDelayText" VerticalAlignment="Center" Foreground="#91A3B5" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Height="30" Margin="0,0,6,0" Padding="10,2" Tag="Right:-1" Click="DelayButton_Click" Content="−1 ms" />
                        <Button Height="30" Margin="0,0,6,0" Padding="10,2" Tag="Right:-0.1" Click="DelayButton_Click" Content="−0,1" />
                        <Button Height="30" Margin="0,0,6,0" Padding="10,2" Tag="Right:0.1" Click="DelayButton_Click" Content="+0,1" />
                        <Button Height="30" Padding="10,2" Tag="Right:1" Click="DelayButton_Click" Content="+1 ms" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Border Grid.Row="5" Padding="14" CornerRadius="8" Background="#19222D">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Foreground="#AAB8C5" FontWeight="SemiBold" Text="GÉOMÉTRIE POUR L’AUTO-CALIBRATION" />
                            <TextBlock Margin="0,3,0,0" Foreground="#91A3B5" FontSize="11"
                                       Text="Mesure depuis chaque point jusqu’au centre de chaque enceinte." />
                        </StackPanel>
                        <Button x:Name="AutoCalibrateButton" DockPanel.Dock="Right" Width="142" Height="36"
                                Click="AutoCalibrateButton_Click" Content="Auto-calibrer" IsEnabled="False" />
                    </DockPanel>
                    <StackPanel x:Name="RoomProfilePanel" Margin="0,12,0,0">
                        <TextBlock Text="PIÈCE / POSITION ACTIVE" Foreground="#AAB8C5" />
                        <ComboBox x:Name="RoomProfileBox" Margin="0,4,0,4" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectionChanged="RoomProfileBox_SelectionChanged" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Height="28" Padding="8,2" Content="Créer" Click="NewProfile_Click" />
                                <Button Height="28" Padding="8,2" Content="Dupliquer" Click="DuplicateProfile_Click" />
                                <Button Height="28" Padding="8,2" Content="Renommer" Click="RenameProfile_Click" />
                                <Button Height="28" Padding="8,2" Content="Supprimer" Click="DeleteProfile_Click" />
                            </StackPanel>
                            <TextBox x:Name="ProfileNameBox" Padding="5,3" Margin="0,0,6,0" ToolTip="Nom du profil à créer ou renommer" />
                        </DockPanel>
                        <TextBlock x:Name="CalibrationHistoryText" Margin="0,5,0,0" Foreground="#91A3B5" TextWrapping="Wrap" FontSize="11" />
                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Foreground="#AAB8C5" FontWeight="SemiBold" Text="Bose gauche" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Center" Foreground="#AAB8C5" FontWeight="SemiBold" Text="Bose droite" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="#91A3B5" Text="Depuis le micro du PC" />
                        <TextBox x:Name="MicLeftDistanceBox" Grid.Row="1" Grid.Column="1" Margin="10,3" Padding="5,3"
                                 TextAlignment="Center" TextChanged="DistanceBox_TextChanged" />
                        <TextBox x:Name="MicRightDistanceBox" Grid.Row="1" Grid.Column="2" Margin="10,3" Padding="5,3"
                                 TextAlignment="Center" TextChanged="DistanceBox_TextChanged" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="#91A3B5" Text="Depuis ta place d’écoute" />
                        <TextBox x:Name="ListenerLeftDistanceBox" Grid.Row="2" Grid.Column="1" Margin="10,3" Padding="5,3"
                                 TextAlignment="Center" TextChanged="DistanceBox_TextChanged" />
                        <TextBox x:Name="ListenerRightDistanceBox" Grid.Row="2" Grid.Column="2" Margin="10,3" Padding="5,3"
                                 TextAlignment="Center" TextChanged="DistanceBox_TextChanged" />
                    </Grid>
                    <TextBlock x:Name="GeometryCorrectionText" Margin="0,8,0,0" Foreground="#91A3B5" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Grid.Row="6" Margin="0,18,0,0" Padding="14" CornerRadius="8" Background="#19222D">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Foreground="#AAB8C5" FontWeight="SemiBold" Text="LATENCE DU PIPELINE" />
                        <ComboBox x:Name="LatencyProfileBox" Margin="0,8,0,0"
                                  DisplayMemberPath="Name" SelectedValuePath="Profile"
                                  SelectionChanged="LatencyProfileBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock x:Name="LatencyHintText" Foreground="#91A3B5" TextWrapping="Wrap" />
                        <TextBlock x:Name="DiagnosticsText" Margin="0,8,0,0" Foreground="#EDF3F7" TextWrapping="Wrap"
                                   Text="Diagnostics disponibles pendant la lecture." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="7" Margin="0,18,0,18" Padding="14" CornerRadius="8" Background="#19222D">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Prêt." />
            </Border>

            <StackPanel Grid.Row="8" Margin="0,0,0,20">
                <Expander Header="Démarrage et zone de notification" Foreground="#EDF3F7" Margin="0,0,0,12">
                    <StackPanel Margin="0,8,0,0">
                        <CheckBox x:Name="AutoStartBox" Foreground="#EDF3F7" Content="Démarrer / reconnecter automatiquement le bridge" Click="StartupOptions_Click" />
                        <CheckBox x:Name="StartInTrayBox" Foreground="#EDF3F7" Content="Lancer masqué dans la zone de notification" Click="StartupOptions_Click" />
                        <CheckBox x:Name="WindowsStartupBox" Foreground="#EDF3F7" Content="Lancer avec ma session Windows" Click="WindowsStartup_Click" />
                        <TextBlock Foreground="#91A3B5" FontSize="11" Text="Réduire ou fermer masque la fenêtre. Pour quitter : menu de l’icône près de l’horloge." TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
                <StackPanel Margin="0,0,0,10" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="SwapButton" Width="108" Margin="0,0,10,0"
                            Click="SwapButton_Click" Content="Inverser G/D" />
                    <Button x:Name="TestButton" Width="112" Margin="0,0,10,0"
                            Click="TestButton_Click" Content="Test G → D" IsEnabled="False" />
                    <Button x:Name="AlignmentTestButton" Width="154"
                            Click="AlignmentTestButton_Click" Content="Calibrer à l’oreille" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StopButton" Width="92" Margin="0,0,10,0"
                            Click="StopButton_Click" Content="Arrêter" IsEnabled="False" />
                    <Button x:Name="StartButton" Width="152" Background="#45D19A" Foreground="#07130F"
                            Click="StartButton_Click" Content="Démarrer la stéréo" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
